<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AHGroceries.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AHGroceries"
    Title="Andrew &amp; Heather’s Groceries"
    BackgroundColor="{StaticResource LightGreen}"
    TitleColor="{StaticResource Black}"
    ForegroundColor="{StaticResource Black}">

    <TabBar>
        <Tab Title="Andrew &amp; Heather’s Groceries">
            <ShellContent
                Title="Andrew &amp; Heather’s Groceries"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Usual Items">
            <ShellContent
                Title="Usual Items"
                ContentTemplate="{DataTemplate local:UsualPage}"
                Route="UsualPage" />
        </Tab>
    </TabBar>

</Shell>